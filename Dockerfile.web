FROM node:22-bookworm-slim AS whisper-builder

# Build the native Linux executable rather than trying to run the Windows desktop bundle.
ARG WHISPER_CPP_COMMIT=d1be6fde11ac6e0407606b4e42fe72d34add8037
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl cmake g++ make git \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir /whisper-src \
    && curl --fail --location --retry 3 "https://github.com/ggml-org/whisper.cpp/archive/${WHISPER_CPP_COMMIT}.tar.gz" \
       | tar -xz --strip-components=1 -C /whisper-src \
    && cmake -S /whisper-src -B /whisper-build -DCMAKE_BUILD_TYPE=Release \
       -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF \
       -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF -DWHISPER_CURL=OFF \
    && cmake --build /whisper-build --target whisper-cli --parallel 2 \
    && /whisper-build/bin/whisper-cli --help

FROM node:22-bookworm-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY electron-builder.yml ./

RUN npm install

COPY . .

RUN npm run build:web && npm rebuild better-sqlite3

FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=3000 \
    DATA_DIR=/app/data

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
# The web server uses its own IPC bridge; Electron's lazy binary installer can block startup.
RUN rm -rf ./node_modules/electron
COPY --from=builder /app/out ./out
COPY --from=builder /app/resources ./resources
COPY --from=whisper-builder /whisper-build/bin/whisper-cli ./resources/whisper/whisper-cli

# Register the bundled caption fonts so libass can resolve them (and fall back
# to Noto Naskh Arabic for Arabic/Hebrew scripts instead of drawing tofu boxes).
RUN mkdir -p /usr/share/fonts/truetype/bang-story \
    && cp /app/resources/fonts/*.ttf /usr/share/fonts/truetype/bang-story/ \
    && fc-cache -f

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/api/auth/status || exit 1

CMD ["node", "out/server.cjs"]
